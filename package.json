{
  "name": "user-dashboard",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lighthouse:audit": "node ./scripts/lighthouse-audit.mjs",
    "lighthouse:ci": "npm run build && START_SERVER=1 LH_PORT=3010 node ./scripts/lighthouse-audit.mjs",
    "perf:bundle-stats": "node ./scripts/print-route-bundle-stats.mjs",
    "perf:check": "npm run build && npm run perf:bundle-stats",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "health": "npm run typecheck && npm run lint && npm run build",
    "health:lab": "npm run lighthouse:ci"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "clsx": "^2.1.1",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "lighthouse": "^13.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
