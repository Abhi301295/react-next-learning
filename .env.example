# Copy to `.env.local` and adjust. Never commit `.env.local`.

# Canonical URL for metadata, sitemap, and robots (see app/layout.tsx, app/sitemap.ts, app/robots.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstream API base for `/api/*` rewrites and server fetches (see next.config.ts, app/lib/server-upstream.ts).
# Production builds require this to be set explicitly.
API_BASE_URL=https://dummyjson.com

# --- Optional: scripts/lighthouse-audit.mjs ---
# LH_BASE_URL=http://127.0.0.1:3000
# LH_PORT=3000
# START_SERVER=1
# CHROME_PATH=
# LH_MIN_PERFORMANCE=0.9
# LH_MIN_OTHER=0.95
